        </mxCell>
        <mxCell id="rep-e-airflow-db-l" value="Инкрементальная выгрузка&lt;br&gt;телеметрии за период" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;" parent="rep-e-airflow-db" vertex="1" connectable="0">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-40" y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rep-e-airflow-ch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="rep-airflow" target="rep-clickhouse" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1620" y="400" />
              <mxPoint x="1620" y="828" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rep-e-airflow-ch-l" value="Загрузка сырых данных,&lt;br&gt;сборка витрины report_daily,&lt;br&gt;обновление etl_state" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;" parent="rep-e-airflow-ch" vertex="1" connectable="0">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="-40" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rep-e-api-ch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Lhtp9tOnbV0N8Cz71-gY-17" target="rep-clickhouse" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rep-e-api-ch-l" value="Читает витрину" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;" parent="rep-e-api-ch" vertex="1" connectable="0">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="-22" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rep-note" value="&lt;b&gt;Подготовка и получение отчётов&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. ETL по расписанию.&lt;/b&gt; DAG bionicpro_reports_etl раз в сутки забирает справочники CRM и приращение телеметрии, кладёт их в ClickHouse и собирает витрину.&lt;br&gt;&lt;b&gt;2. Витрина вместо вычислений в рантайме.&lt;/b&gt; report_daily хранит уже посчитанные суточные агрегаты по клиенту и протезу, поэтому API только читает строки, ничего не агрегируя на лету.&lt;br&gt;&lt;b&gt;3. Быстрый доступ по пользователю.&lt;/b&gt; Ключ сортировки начинается с username, поэтому запрос «мой отчёт за период» читает узкий непрерывный диапазон, а не сканирует витрину.&lt;br&gt;&lt;b&gt;4. Идемпотентность.&lt;/b&gt; Сырьё и витрина лежат в ReplacingMergeTree, поэтому повторный прогон за тот же период не задваивает данные.&lt;br&gt;&lt;b&gt;5. Граница готовности данных.&lt;/b&gt; Таблица etl_state хранит дату, по которую Airflow отработал. Запрос за необработанный период не выдумывает цифры: диапазон усекается, а при полном выходе за границу возвращается 409.&lt;br&gt;&lt;b&gt;6. Доступ только к своему отчёту.&lt;/b&gt; Пользователь берётся из claim токена, а не из параметра запроса; попытка запросить чужой отчёт получает 403." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=12;size=20;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="-60" y="1430" width="1000" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
