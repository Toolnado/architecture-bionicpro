        <mxCell id="sec-e-kc-ldap-l" value="User Federation:&lt;br&gt;bind / search по запросу,&lt;br&gt;import=off, cache=NO_CACHE,&lt;br&gt;маппинг ролей [LDAPS]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="sec-e-kc-ldap" vertex="1" connectable="0">
